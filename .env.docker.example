# BLOK Relance — environnement Docker local. COPIEZ vers `.env.docker` (jamais versionné) :
#   cp .env.docker.example .env.docker
# Compose le charge via `env_file` (voir docker-compose.override.yml) —
# toutes les valeurs ci-dessous sont fictives.
POSTGRES_USER=blok_relance
POSTGRES_PASSWORD=changez_moi_docker_uniquement
POSTGRES_DB=blok_relance

CORE_API_BASE_URL=https://core-api-dev.blok.africa/api/external
CORE_API_KEY=
CORE_API_TIMEOUT_MS=8000
MOCK_CORE=true
ENABLE_CORE_WRITES=false

VOICE_TOOL_SECRET=remplacez_moi_16_caracteres_minimum
OPERATOR_ADMIN_TOKEN=remplacez_moi_admin
OPERATOR_SALES_TOKEN=remplacez_moi_commercial

AETHEX_API_KEY=
AGENT_ID=

BUSINESS_TIMEZONE=Africa/Abidjan
SCHEDULER_ENABLED=true
OUTBOUND_CALLS_ENABLED=false
