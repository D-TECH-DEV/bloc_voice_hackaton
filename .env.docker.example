# ==============================================================================
# BLOK Relance — Modèle de configuration Docker / VPS
# ==============================================================================
# Copiez ce fichier vers `.env.docker` avant de lancer Docker Compose :
#   cp .env.docker.example .env.docker
#
# ATTENTION SÉCURITÉ :
# - `.env.docker` contient des secrets et NE DOIT JAMAIS être versionné ni poussé sur GitHub.
# - Sur un VPS, assignez des permissions strictes au fichier : chmod 600 .env.docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL (Service : postgres, migrate, backend-api)
# ------------------------------------------------------------------------------
# Utilisateur, base et mot de passe de la base PostgreSQL interne (confinée au réseau Docker).
# Obligatoire : Oui
POSTGRES_USER=blok_relance
POSTGRES_PASSWORD=changez_moi_avec_un_mot_de_passe_robuste
POSTGRES_DB=blok_relance

# ------------------------------------------------------------------------------
# 2. Sécurité et Authentification des Opérateurs (Services : backend-api, frontend-commercial)
# ------------------------------------------------------------------------------
# VOICE_TOOL_SECRET : Secret partagé entre l'agent vocal AethexAI et le backend NestJS.
#                     Doit comporter au minimum 16 caractères aléatoires.
# Obligatoire : Oui
VOICE_TOOL_SECRET=remplacez_moi_par_un_secret_aleatoire_de_16_caracteres_min

# OPERATOR_ADMIN_TOKEN : Jeton Bearer pour les actions administrateur (décisions, activations).
# Obligatoire : Oui
OPERATOR_ADMIN_TOKEN=remplacez_moi_token_admin_long_et_securise

# OPERATOR_SALES_TOKEN : Jeton Bearer pour l'interface commerciale et la création de sessions.
# Obligatoire : Oui
OPERATOR_SALES_TOKEN=remplacez_moi_token_commercial_long_et_securise

# ------------------------------------------------------------------------------
# 3. Agent Vocal AethexAI & WebRTC (Services : voice-agent, frontend-commercial)
# ------------------------------------------------------------------------------
# AETHEX_API_KEY : Clé API AethexAI (format ae_live_... ou clé de test).
# AGENT_ID       : Identifiant UUID de l'agent créé sur AethexAI (ex. create_agent.py).
# Obligatoire : Oui pour les interactions vocales réelles, optionnel pour le mode consultation.
AETHEX_API_KEY=ae_live_votre_cle_api_reelle_ici
AGENT_ID=votre_uuid_agent_aethexai_ici

# VOICE_URL : URL du proxy vocal appelée directement par le NAVIGATEUR de l'utilisateur.
#   - En développement local : http://127.0.0.1:5000 ou http://localhost:5000
#   - Sur un VPS en production : http://<ADRESSE_IP_DU_VPS>:5000 ou https://vocal.votre-domaine.com
#     ATTENTION VPS : Ne laissez pas 127.0.0.1 sur un VPS, sinon le navigateur de vos
#     utilisateurs cherchera le service vocal sur leur propre machine !
VOICE_URL=http://127.0.0.1:5000

# ------------------------------------------------------------------------------
# 4. Exposition réseau et ports hôte (Optionnel, défauts sécurisés 127.0.0.1)
# ------------------------------------------------------------------------------
# Par défaut, les services écoutent sur 127.0.0.1 (idéal derrière un reverse-proxy Nginx/Caddy).
# Pour exposer directement sur toutes les interfaces d'un VPS, définissez *_BIND=0.0.0.0.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

BACKEND_BIND=127.0.0.1
BACKEND_PORT=3001

VOICE_BIND=127.0.0.1
VOICE_PORT=5000

# ------------------------------------------------------------------------------
# 5. Intégration Core BLOK (Service : backend-api)
# ------------------------------------------------------------------------------
# URL d'accès à l'API Core BLOK externe.
CORE_API_BASE_URL=https://core-api-dev.blok.africa/api/external
CORE_API_KEY=
CORE_API_TIMEOUT_MS=8000

# MOCK_CORE : Mode simulation locale (fixtures catalogue et clients sans appel Core réel).
# Recommandé : true pour les tests et démos, false avec clé valide en production.
MOCK_CORE=true

# ENABLE_CORE_WRITES : Verrouille les écritures réelles (RFQ, notifications).
# Recommandé : false tant que l'intégration n'est pas certifiée.
ENABLE_CORE_WRITES=false

# ------------------------------------------------------------------------------
# 6. Règles Métier, Moteur de Décision & Téléphonie (Service : backend-api)
# ------------------------------------------------------------------------------
BUSINESS_TIMEZONE=Africa/Abidjan
SCHEDULER_ENABLED=true

# OUTBOUND_CALLS_ENABLED : Sécurité critique — RESTE TOUJOURS 'false' en phase actuelle.
# Aucun appel sortant automatique ne doit être déclenché.
OUTBOUND_CALLS_ENABLED=false
