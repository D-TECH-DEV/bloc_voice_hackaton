    "paths": {
        "/products": {
            "post": {
                "tags": [
                    "External Catalog"
                ],
                "summary": "Rechercher des produits du catalogue",
                "description": "Utilise Meilisearch si disponible, puis fallback SQL.",
                "operationId": "632a51ed19d3f44105beb9deedadcd1a",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "limit": {
                                        "type": "integer",
                                        "example": 25,
                                        "maximum": 100,
                                        "minimum": 1
                                    },
                                    "offset": {
                                        "type": "integer",
                                        "example": 0,
                                        "minimum": 0
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 10,
                                        "nullable": true
                                    },
                                    "search": {
                                        "type": "string",
                                        "example": "ciment",
                                        "nullable": true
                                    },
                                    "min_price": {
                                        "type": "number",
                                        "example": 1000,
                                        "nullable": true
                                    },
                                    "max_price": {
                                        "type": "number",
                                        "example": 25000,
                                        "nullable": true
                                    },
                                    "organization_id": {
                                        "type": "integer",
                                        "example": 42,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Produits recuperes"
                    },
                    "400": {
                        "description": "Erreur de validation"
                    },
                    "401": {
                        "description": "API key manquante ou invalide"
                    },
                    "403": {
                        "description": "Permission access_external_products requise"
                    },
                    "500": {
                        "description": "Erreur serveur"
                    }
                },
                "security": [
                    {
                        "ExternalApiKey": []
                    }
                ]
            }
        },
        "/add_to_cart": {
            "post": {
                "tags": [
                    "External Catalog"
                ],
                "summary": "Ajouter un ou plusieurs produits au panier",
                "description": "Accepte soit une ligne simple, soit un tableau items pour ajout multiple.",
                "operationId": "f65a8d651098e762ad997cc542fe946c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "user_id": {
                                        "type": "integer",
                                        "example": 100
                                    },
                                    "organization_id": {
                                        "type": "integer",
                                        "example": 42
                                    },
                                    "product_variant_id": {
                                        "type": "integer",
                                        "example": 123,
                                        "nullable": true
                                    },
                                    "qty": {
                                        "type": "integer",
                                        "example": 2,
                                        "nullable": true,
                                        "minimum": 1
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "product_variant_id",
                                                "qty"
                                            ],
                                            "properties": {
                                                "product_variant_id": {
                                                    "type": "integer",
                                                    "example": 123
                                                },
                                                "qty": {
                                                    "type": "integer",
                                                    "example": 2,
                                                    "minimum": 1
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Produit ajoute ou quantite mise a jour"
                    },
                    "400": {
                        "description": "Erreur de validation"
                    },
                    "401": {
                        "description": "API key manquante ou invalide"
                    },
                    "403": {
                        "description": "Permission access_external_add_to_cart requise ou utilisateur hors organisation"
                    },
                    "404": {
                        "description": "Variante introuvable ou inactive"
                    },
                    "500": {
                        "description": "Erreur serveur"
                    }
                },
                "security": [
                    {
                        "ExternalApiKey": []
                    }
                ]
            }
        },
