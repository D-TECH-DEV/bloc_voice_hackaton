        "/rfqs": {
            "post": {
                "tags": [
                    "External RFQ"
                ],
                "summary": "Creer une RFQ depuis une app externe",
                "operationId": "66d4005457672192d0638ffbabbf511f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "organization_id"
                                ],
                                "properties": {
                                    "organization_id": {
                                        "type": "integer",
                                        "example": 42
                                    },
                                    "file_name": {
                                        "type": "string",
                                        "example": "rfq-discutai.pdf",
                                        "nullable": true
                                    },
                                    "line_items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "extracted_text": {
                                                    "type": "string",
                                                    "example": "Ciment 50kg",
                                                    "nullable": true
                                                },
                                                "matched_product": {
                                                    "type": "object",
                                                    "nullable": true,
                                                    "additionalProperties": true
                                                },
                                                "matched_products": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "additionalProperties": true
                                                    },
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "RFQ creee",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "error": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "RFQ créée avec succès."
                                        },
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "API key manquante ou invalide"
                    },
                    "403": {
                        "description": "Permission access_external_create_rfqs requise"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    },
                    "500": {
                        "description": "Erreur serveur"
                    }
                },
                "security": [
                    {
                        "ExternalApiKey": []
                    }
                ]
            }
        },
