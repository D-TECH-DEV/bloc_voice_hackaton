# Secrets locaux (clés API réelles) — jamais versionnés.
.env
.env.*
!.env.example
!.env.*.example
.env.docker
.env.docker.*
!.env.docker.example

# Environnement virtuel Python.
.venv/
blok_voice/.venv/

# Bytecode et caches Python.
__pycache__/
*.py[cod]

# Caches d'outils et fichiers temporaires.
.pytest_cache/
*.log
.DS_Store
*.swp
*.bak
*.tmp
api_nextjs/

# Backend NestJS / Frontend Next.js (dépendances, build, données locales).
node_modules/
dist/
.next/
out/
backend/.pgdata/
*.tsbuildinfo
coverage/
