# BLOK Relance — Backend NestJS. Copiez vers `backend/.env` (jamais versionné).
# Toutes les valeurs ci-dessous sont fictives. Le réel vient de l'environnement.

# --- Serveur ---
PORT=3001

# --- Base de données (PostgreSQL local, voir docs/runbook.md) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=blok_relance
DB_PASSWORD=changez_moi_dev_uniquement
DB_NAME=blok_relance
DB_NAME_TEST=blok_relance_test

# --- Core API BLOK (source de vérité métier, lecture/écriture autorisées uniquement) ---
CORE_API_BASE_URL=https://core-api-dev.blok.africa/api/external
CORE_API_KEY=
CORE_API_TIMEOUT_MS=8000
# Mode secours : sans clé, le connecteur répond avec des fixtures marquées "mock".
MOCK_CORE=true
# Écritures Core (RFQ, panier, notifications) désactivées par défaut.
ENABLE_CORE_WRITES=false

# --- Outils vocaux (AethexAI -> backend). Secret partagé, longueur >= 16. ---
VOICE_TOOL_SECRET=remplacez_moi_16_caracteres_minimum

# --- Opérateurs (interface interne). Jetons opaques ; comparés par hash. ---
OPERATOR_ADMIN_TOKEN=remplacez_moi_admin
OPERATOR_SALES_TOKEN=remplacez_moi_commercial

# --- Moteur de décision (valeurs prudentes de développement, à valider métier/juridique) ---
BUSINESS_TIMEZONE=Africa/Abidjan
MAX_ATTEMPTS_PER_TASK=3
MIN_DELAY_BETWEEN_ATTEMPTS_HOURS=72
QUIET_HOURS_START=20
QUIET_HOURS_END=8

# --- Téléphonie sortante : RESTE DÉSACTIVÉE tant que la production n'est pas validée. ---
# L'activation exige EN PLUS une ligne `telephony_outbound` active en base (double verrou).
OUTBOUND_CALLS_ENABLED=false

# --- Planificateur (réévalue les tâches, NE compose JAMAIS d'appel) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
